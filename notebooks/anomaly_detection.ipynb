   "source": [
    "## 7. Key Insights & Recommendations"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "best_method = comparison.loc[comparison['F1 Score'].idxmax(), 'Method']\n",
    "best_f1     = comparison['F1 Score'].max()\n",
    "\n",
    "print('=== KEY FINDINGS ===')\n",
    "print(f'1. Best performing method: {best_method} (F1 = {best_f1:.3f})')\n",
    "print(f'2. Anomaly rate: {df[\"is_anomaly\"].mean()*100:.1f}% — highly imbalanced')\n",
    "print(f'   → Use F1 / Precision-Recall, NOT accuracy')\n",
    "print(f'3. Daily pattern is strong — deseasonalizing improves all methods')\n",
    "print(f'4. Isolation Forest detects both spike and flatline anomalies without labeling')\n",
    "\n",
    "# Anomaly breakdown by type\n",
    "spikes   = df[(df['is_anomaly']==1) & (df['pm25_ugm3']>60)]\n",
    "flatline = df[(df['is_anomaly']==1) & (df['pm25_ugm3']<1)]\n",
    "print(f'\\nAnomaly type breakdown:')\n",
    "print(f'  Spikes (PM2.5 > 60): {len(spikes)} observations')\n",
    "print(f'  Flatlines (PM2.5 ≈ 0): {len(flatline)} observations')\n",
    "\n",
    "print('\\n=== BUSINESS RECOMMENDATIONS ===')\n",
    "print('1. Implement real-time alerting when rolling Z-score > 3.5')\n",
    "print('2. Use Isolation Forest for offline batch detection on full history')\n",
    "print('3. Separate spike vs flatline detection (different thresholds needed)')\n",
    "print('4. Enrich features with external events (holidays, weather alerts)')"
   ]
  },
